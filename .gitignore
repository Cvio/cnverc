# setup-models.sh downloads all of it.
*.onnx
*.onnx.json
*.gguf
*.bin
*.tar.bz2
*.tar.gz
*.zip
espeak-ng-data/
*tokens.txt
MODEL_CARD

# Model archives downloaded during setup (README step 6).
/downloads/

